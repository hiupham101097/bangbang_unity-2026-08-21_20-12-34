{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blue-frog-fec8",
  "main": "Cloudflare/src/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "BangBangMatch" },
      { "name": "DIRECTORY", "class_name": "BangBangDirectory" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BangBangMatch", "BangBangDirectory"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
